{
  "geode": "v6.0.0",
  "gd": {
    "android": "2.2091"
  },
  "id": "velocityfx",
  "name": "VelocityFX",
  "version": "v0.2.0",
  "developer": "VelocityFX",
  "description": "A floating Android gameplay panel with FPS controls and a lightweight player afterimage trail.",
  "tags": [
    "gameplay",
    "interface",
    "customization"
  ],
  "settings": {
    "fps-enabled": {
      "name": "FPS interval request",
      "type": "bool",
      "default": false
    },
    "target-fps": {
      "name": "Target FPS",
      "type": "int",
      "default": 120,
      "min": 30,
      "max": 360
    },
    "motion-blur-enabled": {
      "name": "Player afterimage trail",
      "description": "Lightweight sprite trail; not full-screen optical motion blur.",
      "type": "bool",
      "default": false
    },
    "blur-intensity": {
      "name": "Trail intensity",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1.0
    }
  }
}